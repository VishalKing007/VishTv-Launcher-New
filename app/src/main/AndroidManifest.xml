<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RAM Boost: background processes band karne ke liye. Koi INTERNET
         permission nahi — launcher bilkul ad-free aur offline hai. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Network jaankari wale tool ke liye (SSID/IP) — ye internet nahi hai. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Apna photo browser: TV/USB storage ki photos padhne ke liye.
         TV me system file picker nahi hota, isliye ye zaroori hai.
         Runtime par maangi jati hai; photo kahin bahar nahi jati. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:icon="@drawable/ic_launcher"
        android:label="Vishie TV"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wallpaper chunne ki screen — sirf launcher ke andar se khulti hai. -->
        <activity
            android:name=".WallpaperActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Apna photo browser — TV/USB se photo chunta hai, koi bahari
             file-picker app nahi chahiye. -->
        <activity
            android:name=".PhotoBrowserActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
